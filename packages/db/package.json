{
  "name": "@carble/db",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm migrate && pnpm studio",
    "generate": "drizzle-kit generate:sqlite",
    "migrate": "drizzle-kit push:sqlite",
    "studio": "drizzle-kit studio --host 0.0.0.0"
  },
  "files": [
    "lib",
    "migrations",
    "drizzle.config.ts"
  ],
  "main": "./lib/index.ts",
  "exports": {
    ".": "./lib/index.ts",
    "./schema": "./lib/schema.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "drizzle-kit": "^0.21.2"
  },
  "dependencies": {
    "better-sqlite3": "^10.0.0",
    "drizzle-orm": "^0.30.10"
  }
}
