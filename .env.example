NUXT_PORT=3000

# サイト全体にBasic認証をかけたい場合に設定
NUXT_BASIC_AUTH_USER=
NUXT_BASIC_AUTH_PASSWORD=

### Better Auth関連 ###
# https://www.better-auth.com/docs/installation#set-environment-variables を参考にランダム文字列を設定
BETTER_AUTH_SECRET=
# 設置URL
BETTER_AUTH_URL=http://localhost:3000
# nginx などのプロキシの後ろに置く場合に設定（ログインのレート制限を、利用者の IP ごとに数えるため）
# どちらも空なら IP を判定しない（IP ごとのレート制限はかからない）
# - nginx で proxy_set_header X-Real-IP $remote_addr; としている場合: BETTER_AUTH_IP_HEADERS=x-real-ip
# - nginx で proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; としている場合: BETTER_AUTH_TRUSTED_PROXIES に nginx の IP（例: 172.17.0.1）
BETTER_AUTH_IP_HEADERS=
BETTER_AUTH_TRUSTED_PROXIES=
# https://www.better-auth.com/docs/authentication/google を参考にGoogle OAuth認証のキーを取得・設定
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
