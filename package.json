{
  "name": "carble",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm --filter @carble/* --parallel dev",
    "build": "pnpm --filter @carble/app build",
    "cli": "pnpm --filter @carble/cli exec jiti",
    "test:e2e": "bash tests/e2e/scripts/run.sh",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --output ./packages/db/lib/schema/auth.ts"
  },
  "devDependencies": {
    "better-auth": "^1.4.7"
  }
}
